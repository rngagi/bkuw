{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bkuw",
  "version": "0.6.1",
  "identifier": "app.bkuw.desktop",
  "build": {
    "beforeDevCommand": "pnpm audio:prepare && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm audio:prepare && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "bkuw",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; media-src blob:",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/audio/"
    ]
  }
}
